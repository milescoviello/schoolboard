#!/usr/bin/env python3
"""schoolboard — one board for classes, assignments and announcements."""
import argparse
import sys
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from schoolboard import auth, canvas, config, coursesite, notify, server, store, timetable  # noqa: E402


def cmd_serve(args):
    server.serve(args.bind, args.port)


def cmd_sync(args):
    print(server.sync_once())


def cmd_today(args):
    cfg = config.load_config()
    schedule = config.load_schedule()
    tz = timetable.tzinfo(cfg["timezone"])
    now = datetime.now(tz)
    print(now.strftime("%A %B %-d, %Y — %-I:%M %p %Z"))
    meetings = timetable.meetings_on(schedule, now.date(), tz)
    if not meetings:
        print("  no classes today")
    for m in meetings:
        mark = {"current": ">>", "past": "  ", "upcoming": " ·"}[m.status(now)]
        print(f"  {mark} {m.start.strftime('%-I:%M'):>7}-{m.end.strftime('%-I:%M %p').lower():<9} "
              f"{m.code:<10} {m.course['room']}")
    cur, nxt = timetable.current_and_next(schedule, now, tz)
    if cur:
        print(f"\n  now: {cur.code} until {cur.end.strftime('%-I:%M %p').lower()}")
    if nxt:
        print(f"  next: {nxt.code} {nxt.start.strftime('%a %-I:%M %p').lower()} in {nxt.course['room']}")


def cmd_connect(args):
    cfg = config.load_config()
    base = cfg["canvas"]["base_url"]
    print(f"Canvas host: {base}")
    token = ""
    if args.token_file:
        # Preferred for an existing token: never lands in argv, so it stays out
        # of `ps` output and shell history.
        token = Path(args.token_file).read_text(encoding="utf-8").strip()
        print(f"Reading token from {args.token_file}")
    elif args.token:
        token = args.token.strip()
    else:
        print("Create a token: Canvas > Account > Settings > Approved Integrations >")
        print("  '+ New Access Token'. Purpose: schoolboard. Leave expiry blank.")
        token = input("\nPaste token: ").strip()
    if not token:
        print("No token given; nothing changed.")
        return 1
    try:
        who = canvas.Canvas(base, token).profile()
    except canvas.CanvasError as exc:
        print(f"\nRejected: {exc}")
        return 1
    cfg["canvas"]["token"] = token
    path = config.save_config(cfg)
    print(f"\nConnected as {who.get('name')} <{who.get('primary_email','')}>")
    print(f"Token saved to {path} (mode 600)")
    print(server.sync_once())
    return 0


def cmd_notify(args):
    cfg = config.load_config()
    if args.test:
        env = notify.read_env(cfg.get("notify", {}).get("telegram_env"))
        bot = notify.Telegram(env.get("TELEGRAM_BOT_TOKEN"), env.get("TELEGRAM_CHAT_ID"))
        ok, note = bot.send("<b>schoolboard</b>\nNotifications are wired up. "
                            "You'll get a nudge before class and before deadlines.")
        print("test message sent" if ok else f"test failed: {note}")
        return 0 if ok else 1
    print(server.notify_once(force=args.force))
    return 0


def cmd_sites(args):
    cfg = config.load_config()
    _, note = coursesite.refresh(cfg.get("course_sites"))
    print(note)
    from datetime import date as _d
    today = _d.today()
    for entry in coursesite.entries_for(today):
        print(f"  today: {entry['course']} {entry['kind']} {entry['label']} {entry['url'] or ''}")
    return 0


def _mark(args, done):
    matches = server.find_items(args.text, done=not done)
    if not matches:
        print(f"nothing matching {args.text!r}"
              f"{' that is still open' if done else ' that is marked done'}")
        return 1
    if len(matches) > 1 and not args.all:
        print(f"{len(matches)} matches — be more specific, or pass --all:")
        for row in matches:
            print(f"  {row['course']:<12} {row['title'][:58]}")
        return 1
    for row in matches:
        ok, note = server.mark_item(row["id"], done=done)
        print(("  " if ok else "  FAILED ") + note)
    return 0


def cmd_done(args):
    return _mark(args, True)


def cmd_undone(args):
    return _mark(args, False)


def cmd_set_password(args):
    """Password for the public URL only. The tailnet needs none — Tailscale has
    already authenticated the caller."""
    import getpass
    import secrets
    cfg = config.load_config()
    if args.random:
        words = ("harbor slate mango pylon cinder willow tundra basalt quartz "
                 "meadow cobalt lantern").split()
        password = "-".join(secrets.choice(words) for _ in range(4))
        print(f"\nGenerated password:\n\n    {password}\n")
    else:
        password = args.password or getpass.getpass("New password: ")
        if not password:
            print("No password given; nothing changed.")
            return 1
        if len(password) < 8:
            print("Use at least 8 characters.")
            return 1
    cfg.setdefault("auth", {})["password_hash"] = auth.hash_password(password)
    auth.ensure_secret(cfg, config.save_config)
    config.save_config(cfg)
    print("Saved. Restart the service for it to take effect:")
    print("  sudo service schoolboard restart")
    return 0


def cmd_status(args):
    cfg = config.load_config()
    conn = store.connect()
    tz = timetable.tzinfo(cfg["timezone"])
    print(f"timezone     {cfg['timezone']}  (now {datetime.now(tz).strftime('%-I:%M %p %Z')})")
    print(f"host clock   {datetime.now().astimezone().strftime('%-I:%M %p %Z')}")
    print(f"canvas       {'connected' if cfg['canvas']['token'] else 'NOT connected'}  {cfg['canvas']['base_url']}")
    print(f"last sync    {store.get_meta(conn, 'last_sync') or 'never'}")
    err = store.get_meta(conn, "last_sync_error")
    if err:
        print(f"last error   {err}")
    counts = conn.execute("SELECT kind, COUNT(*) c FROM items GROUP BY kind").fetchall()
    print("items        " + (", ".join(f"{r['c']} {r['kind']}" for r in counts) or "none"))
    nc = cfg.get("notify", {})
    print(f"notify       {'on' if nc.get('enabled') else 'off'}  "
          f"class -{nc.get('class_lead_minutes')}m, due {nc.get('due_thresholds_hours')}h, "
          f"digest {nc.get('digest_hour')}:00, quiet {nc.get('quiet_start')}-{nc.get('quiet_end')}")
    sent = conn.execute("SELECT COUNT(*) c FROM notifications").fetchone()["c"]
    print(f"             {sent} notification keys recorded"
          f"{'' if store.get_meta(conn, 'notify_primed') else ' (not primed yet)'}")
    err = store.get_meta(conn, "notify_error")
    if err:
        print(f"notify error {err}")
    grades = store.get_meta(conn, "grades") or []
    print(f"grades       {len(grades)} courses reporting")
    print(f"mail dropped {store.get_meta(conn, 'mail_dropped', 0)} (see mail-dropped.log)")
    gated = "set" if (cfg.get("auth") or {}).get("password_hash") else "NOT SET (public URL is open)"
    print(f"serving on   http://{cfg['bind']}:{cfg['port']} (trusted) "
          f"+ 127.0.0.1:{cfg.get('public_port')} (public, login {gated})")


def main():
    parser = argparse.ArgumentParser(prog="schoolboard", description=__doc__)
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("serve", help="run the web board")
    p.add_argument("--bind"); p.add_argument("--port", type=int)
    p.set_defaults(func=cmd_serve)

    sub.add_parser("sync", help="pull Canvas once").set_defaults(func=cmd_sync)
    sub.add_parser("today", help="print today's classes").set_defaults(func=cmd_today)
    sub.add_parser("status", help="show configuration and sync state").set_defaults(func=cmd_status)

    for name, helptext, fn in (("done", "mark work complete (writes to Canvas)", cmd_done),
                              ("undone", "reopen something marked complete", cmd_undone)):
        q = sub.add_parser(name, help=helptext)
        q.add_argument("text", help="part of the title")
        q.add_argument("--all", action="store_true", help="apply to every match")
        q.set_defaults(func=fn)

    p = sub.add_parser("set-password", help="set the password for the public URL")
    p.add_argument("--password")
    p.add_argument("--random", action="store_true", help="generate a passphrase")
    p.set_defaults(func=cmd_set_password)

    p = sub.add_parser("notify", help="run one notification pass")
    p.add_argument("--test", action="store_true", help="send a test message now")
    p.add_argument("--force", action="store_true", help="send even on the first (priming) run")
    p.set_defaults(func=cmd_notify)

    sub.add_parser("sites", help="refresh public course sites").set_defaults(func=cmd_sites)

    p = sub.add_parser("connect", help="add a Canvas access token")
    p.add_argument("--token", help="token as a literal (visible in ps; prefer --token-file)")
    p.add_argument("--token-file", help="read the token from a file")
    p.set_defaults(func=cmd_connect)

    args = parser.parse_args()
    sys.exit(args.func(args) or 0)


if __name__ == "__main__":
    main()
